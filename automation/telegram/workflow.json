    {
      "id": "read-active-services",
      "name": "Read active services",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        1680,
        80
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "select coalesce(jsonb_agg(jsonb_build_object('id', id, 'name', name) order by sort_order, id), '[]'::jsonb) as services\nfrom public.services\nwhere active = true and ($1::uuid is null or id = $1::uuid);",
        "options": {
          "queryReplacement": "={{ [ $('Normalize update').first().json.serviceId ] }}"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "prepare-reply",
      "name": "Prepare reply",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1920,
        160
      ],
      "parameters": {
        "jsCode": "function prepareReply(event, queryResult) {\r\n  const reply = { chatId: event.chatId, text: event.text ?? '', rows: [], hasButtons: false };\r\n  if (event.kind === 'hint' || event.kind === 'ignore') return reply;\r\n  let services = queryResult?.services;\r\n  if (typeof services === 'string') { try { services = JSON.parse(services); } catch { services = null; } }\r\n  const valid = Array.isArray(services) && services.every(s => s && typeof s.name === 'string' && s.name.trim() && typeof s.id === 'string' && /^[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}$/i.test(s.id));\r\n  if (queryResult?.error || !valid) return { ...reply, text: 'Не удалось загрузить услуги. Попробуйте ещё раз немного позже.' };\r\n  if (event.kind === 'selection') return { ...reply, text: services.length ? `Вы выбрали: ${services[0].name.replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;')}` : 'Услуга больше недоступна. Отправьте /start, чтобы обновить меню.' };\r\n  if (!services.length) return { ...reply, text: 'Сейчас нет доступных услуг. Попробуйте позже.' };\r\n  return {\r\n    ...reply, text: 'Выберите услугу:', hasButtons: true,\r\n    rows: services.map(service => [{ text: service.name, callback_data: `svc:${service.id}` }]),\r\n  };\r\n}\nreturn [{ json: prepareReply($('Normalize update').first().json, $input.first().json) }];"
      }
    },
    {
      "id": "send-reply",
      "name": "Send reply",
      "type": "CUSTOM.ldLatteTelegram",
