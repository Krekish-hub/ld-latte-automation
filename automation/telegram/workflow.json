{
  "name": "LD LATTE - dynamic service menu",
  "nodes": [
    {
      "id": "telegram-updates",
      "name": "Telegram updates",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        240
      ],
      "parameters": {
        "updates": [
          "message",
          "callback_query"
        ],
        "additionalFields": {}
      },
      "webhookId": "e084eddb-efb9-4600-b8a9-3d682b813365"
    },
    {
      "id": "normalize-update",
      "name": "Normalize update",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        240
      ],
      "parameters": {
        "jsCode": "function normalizeUpdate(update) {\r\n  const callback = update?.callback_query;\r\n  const message = callback?.message ?? update?.message;\r\n  const chat = message?.chat;\r\n  if (chat?.type !== 'private' || !Number.isSafeInteger(chat.id)) return { kind: 'ignore', chatId: null, queryId: '', serviceId: null };\r\n  const common = { chatId: chat.id, queryId: '', serviceId: null };\r\n  if (callback) {\r\n    if (typeof callback.id !== 'string' || !callback.id) return { ...common, kind: 'ignore', chatId: null };\r\n    common.queryId = callback.id;\r\n    const match = /^svc:([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})$/i.exec(callback.data ?? '');\r\n    if (!match) return { ...common, kind: 'hint', text: 'Эта кнопка устарела. Отправьте /start, чтобы открыть меню.' };\r\n    return { ...common, kind: 'selection', serviceId: match[1].toLowerCase() };\r\n  }\r\n  const text = typeof message.text === 'string' ? message.text.trim() : '';\r\n  if (/^\\/start(?:@ZmeiiniyBot)?(?:\\s+.*)?$/i.test(text)) return { ...common, kind: 'start' };\r\n  return { ...common, kind: 'hint', text: 'Чтобы выбрать услугу, отправьте /start.' };\r\n}\nreturn [{ json: normalizeUpdate($input.first().json) }];"
      }
    },
    {
      "id": "private-chat",
