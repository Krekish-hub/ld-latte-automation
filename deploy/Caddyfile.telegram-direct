# Direct Telegram ingress on the n8n VPS. Keep existing Xray :443/:8443 intact.
{
    admin off
    auto_https disable_redirects
    persist_config off
    storage file_system {
        root /var/lib/ld-latte-webhook/caddy
    }
}

https://hooks-latte.144-31-244-32.nip.io:88 {
    tls {
        issuer acme {
            disable_tlsalpn_challenge
        }
    }
    header {
        -Server
        X-Content-Type-Options nosniff
    }
    handle /healthz {
        reverse_proxy 127.0.0.1:5678
    }
    handle /webhook/* {
        # Preserve X-Telegram-Bot-Api-Secret-Token for native n8n verification.
        reverse_proxy 127.0.0.1:5678
    }
    handle {
        respond 404
    }
}
