N8N_ENCRYPTION_KEY=REPLACE_WITH_RANDOM_VALUE_AND_KEEP_IN_PRIVATE_BACKUP
N8N_HOST=hooks.example.com
N8N_PORT=5678
N8N_PROTOCOL=https
N8N_WEBHOOK_URL=https://hooks.example.com/
N8N_EDITOR_BASE_URL=http://localhost:5678
N8N_PROXY_HOPS=1
GENERIC_TIMEZONE=Asia/Chita
TZ=Asia/Chita
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true
N8N_DIAGNOSTICS_ENABLED=false
N8N_PERSONALIZATION_ENABLED=false
EXECUTIONS_DATA_SAVE_ON_SUCCESS=none
EXECUTIONS_DATA_SAVE_ON_ERROR=all
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=72
N8N_CONCURRENCY_PRODUCTION_LIMIT=2
NODE_OPTIONS=--max-old-space-size=512
# Enable after installing the public CA certificate; see deploy/README.md.
# NODE_EXTRA_CA_CERTS=/home/node/.n8n/supabase-ca.crt
